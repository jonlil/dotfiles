# Stable /dev/dri symlinks for GPU selection (AQ_DRM_DEVICES).
# cardN numbering is assigned at boot and can change; these follow the PCI slot.
# Intel Arrow Lake iGPU
KERNEL=="card*", KERNELS=="0000:00:02.0", SUBSYSTEM=="drm", SUBSYSTEMS=="pci", SYMLINK+="dri/intel-igpu"
# NVIDIA GB205M GeForce RTX 5070 Ti Mobile
KERNEL=="card*", KERNELS=="0000:02:00.0", SUBSYSTEM=="drm", SUBSYSTEMS=="pci", SYMLINK+="dri/nvidia-dgpu"
