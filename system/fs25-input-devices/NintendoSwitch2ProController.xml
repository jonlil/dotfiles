<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
  Nintendo Switch 2 Pro Controller, presented through hidguise.

  The game ships no definition for product 2069. Its NintendoSwitchProController
  profile does match this pad by name - vendor 057E plus the keywords "pro" and
  "controller" - but that profile is written for the older pad and maps only
  twelve buttons, so C, the two back paddles and Capture are unreachable.

  This file matches on the product key instead, and maps all seventeen.

  Two deliberate differences from the shipped Nintendo profile:

  1. The stick clicks are NOT crossed. That profile maps physical 10 to logical
     11 and physical 11 to logical 10, which neither the Xbox nor the PlayStation
     profile does - both use LS=10, RS=11. hidguise crossed its own output to
     compensate; with this file it no longer needs to, so both are straight.

  2. Buttons beyond the usual twelve use logical 13, 14, 15 and 20. Logical
     16 to 19 are deliberately skipped: the Xbox profile uses them for a d-pad
     exposed as buttons, and this pad's d-pad is a hat.
-->
<deviceMapping backends="rawInput;directInput">
    <productKey productId="2069" vendorId="057E" />
    <productName vendorId="057E">
        <keyword text="switch" />
        <keyword text="2" />
        <keyword text="pro" />
        <keyword text="controller" />
    </productName>
    <category>gamepad</category>  <!-- gamepad, wheel, joystick, farmWheel, farmSidePanel -->
    <buttonMappings>
        <buttonMapping physical="0"  logical="1"  label="B" />
        <buttonMapping physical="1"  logical="2"  label="A" />
        <buttonMapping physical="2"  logical="0"  label="Y" />
        <buttonMapping physical="3"  logical="3"  label="X" />
        <!--
          LB/RB/LT/RT rather than L/R/ZL/ZR, which is what the buttons actually
          say on this pad.

          The game draws these from a fixed vocabulary of label strings; a label
          outside it renders as an empty box in the HUD. Collected from all 72
          shipped profiles, that vocabulary has LB, RB, LT and RT but no ZL, ZR,
          L or R - and GIANTS' own Nintendo profile uses the Xbox names for the
          same reason. Using the printed names left "ZL", "ZL + ZR" and "ZR"
          blank in the advanced-controls panel.
        -->
        <buttonMapping physical="4"  logical="4"  label="LB" />
        <buttonMapping physical="5"  logical="5"  label="RB" />
        <buttonMapping physical="6"  logical="6"  label="LT" />
        <buttonMapping physical="7"  logical="7"  label="RT" />
        <buttonMapping physical="8"  logical="8"  label="-" />
        <buttonMapping physical="9"  logical="9"  label="+" />
        <buttonMapping physical="10" logical="10" label="LS" />
        <buttonMapping physical="11" logical="11" label="RS" />
        <!--
          These five keep their real names and will draw as empty boxes in the
          HUD, because the vocabulary has no equivalent - they are buttons the
          game has never seen. Only GR happens to exist in it, borrowed from a
          wheel profile, so that one renders by coincidence.

          The alternative was to label them with their button numbers, which do
          render, the way the Saitek panel labels its 28 buttons "1" to "28".
          Readable in the binding menu beats visible in the HUD here: these are
          the buttons you have to look up, not the ones you use by reflex.
        -->
        <buttonMapping physical="12" logical="12" label="Home" />
        <buttonMapping physical="13" logical="13" label="C" />
        <buttonMapping physical="14" logical="14" label="GL" />
        <buttonMapping physical="15" logical="15" label="GR" />
        <buttonMapping physical="16" logical="20" label="Capture" />
    </buttonMappings>
    <axisMappings>
        <axisMapping physical="X"  logical="0" scale="1.2" offset="0" label="LS-X" />
        <axisMapping physical="Y"  logical="1" scale="1.2" offset="0" label="LS-Y" />
        <axisMapping physical="RX" logical="2" scale="1.2" offset="0" label="RS-X" />
        <axisMapping physical="RY" logical="3" scale="1.2" offset="0" label="RS-Y" />
    </axisMappings>
</deviceMapping>
