pkgname=viska-cli-git
_pkgname=viska-cli
pkgver=0.3.0.r29.57321d2
pkgrel=1
pkgdesc='Viska — control your TV from the command line'
arch=('x86_64')
url='https://github.com/viska-ab/viska-cli'
license=('MIT')
depends=('gcc-libs' 'openssl' 'dbus')
makedepends=('cargo' 'git' 'nasm')
provides=('viska')
conflicts=('viska' 'smartycrank')
# The `ring` crate bundles hand-written assembly objects that can't take part in
# LTO; makepkg's global `lto` option injects -flto into ring's cc build and breaks
# linking (undefined reference to ring_core_*). Disable LTO for this package.
options=('!lto')
# viska-cli depends on the rs-matter fork via a path dependency (../rs-matter/rs-matter),
# so it is cloned as a sibling here and pinned to the commit viska-cli is built against.
_rsmatter_commit=aca053cc84a55f4792ab17e86f83bed62fc8b36e
source=(
    "git+ssh://git@github.com/viska-ab/viska-cli.git"
    "rs-matter::git+ssh://git@github.com/viska-ab/rs-matter.git#commit=${_rsmatter_commit}"
)
sha256sums=('SKIP'
            'SKIP')

pkgver() {
    cd "$_pkgname"
    printf '%s.r%s.%s' \
        "$(grep '^version' Cargo.toml | head -1 | sed 's/.*"\(.*\)"/\1/')" \
        "$(git rev-list --count HEAD)" \
        "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$_pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    export RUSTFLAGS="-C linker=gcc"
    cargo build --release
}

package() {
    cd "$_pkgname"
    install -Dm755 "target/release/viska" "$pkgdir/usr/bin/viska"
}
