#!/bin/sh
# Tar bort doda HID-enhetsposter ur ett Wine/Proton-prefix.
#
# Varje virtuell inputenhet som skapas och forsvinner lamnar en post i
# prefixets register. Wine forsoker oppna dem vid varje start och loggar
#     warn:rawinput:add_device Failed to open device file ... 0xc0000034
# och sa lange sadana spoken finns for ett vendor/product kan spel hoppa over
# den levande enheten med samma id. Det var precis vad som hande med Saiteks
# sidopanel i FS25 - se system/gaming.md.
#
# Anvandning:
#   wine-clean-ghost-devices <prefix> [VID:PID ...]
#
# Utan id:n listas bara vad som finns. Spelet maste vara stangt.
#
# Exempel:
#   wine-clean-ghost-devices ~/.local/share/Steam/steamapps/compatdata/<appid>/pfx
#   wine-clean-ghost-devices ~/.local/share/Steam/steamapps/compatdata/<appid>/pfx 0738:2218
set -eu

PFX="${1:-}"
[ -n "$PFX" ] && [ -d "$PFX" ] || { echo "Anvandning: $0 <prefix> [VID:PID ...]" >&2; exit 1; }
shift || true

if [ $# -eq 0 ]; then
    echo "Enhetsposter i prefixet:"
    grep -ohE 'Enum\\\\(HID|WINEBUS)\\\\VID_[0-9A-Fa-f]+&PID_[0-9A-Fa-f]+[^]\\]*' \
        "$PFX/system.reg" 2>/dev/null | sort -u | sed 's/^/  /'
    echo
    echo "Ange VID:PID for att ta bort, t.ex. $0 $PFX 0738:2218"
    exit 0
fi

TS=$(date +%Y%m%d-%H%M%S)
for f in system.reg user.reg; do
    [ -f "$PFX/$f" ] && cp "$PFX/$f" "$PFX/$f.bak-$TS"
done
echo "Backup: *.reg.bak-$TS"

python3 - "$PFX" "$@" <<'PY'
import sys, re, os
pfx = sys.argv[1]
targets = []
for a in sys.argv[2:]:
    vid, pid = a.split(':')
    targets.append(f"VID_{vid}&PID_{pid}".lower())

for fn in ('system.reg', 'user.reg'):
    p = os.path.join(pfx, fn)
    if not os.path.exists(p):
        continue
    s = open(p, encoding='utf-8', errors='surrogateescape').read()
    parts = re.split(r'(?m)^(?=\[)', s)
    keep, removed = [], 0
    for part in parts:
        head = part.split('\n', 1)[0]
        if head.startswith('[') and any(t in head.lower() for t in targets):
            removed += 1
            continue
        keep.append(part)
    open(p, 'w', encoding='utf-8', errors='surrogateescape').write(''.join(keep))
    print(f"  {fn}: {removed} sektioner borttagna")
PY
echo "Klart. Wine bygger om de levande posterna vid nasta start."
